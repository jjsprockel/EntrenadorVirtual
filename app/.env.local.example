# ── Supabase (obligatorio para auth en la nube + sync) ────────────────────────
# Obtén estos valores en: supabase.com → tu proyecto → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Email (EmailJS — para enviar correos a usuarios nuevos) ───────────────────
# https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx

# ── URL pública de la app (Vercel la inyecta automáticamente) ─────────────────
VITE_APP_URL=https://tu-app.vercel.app
